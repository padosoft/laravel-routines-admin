{
    "name": "padosoft/laravel-routines-admin",
    "description": "Enterprise admin panel (React 19 + Vite 8 + Tailwind 4) for padosoft/laravel-routines \u2014 schedules, run ledger, mandates and the queue of routines that stopped to ask a human.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "routines",
        "scheduler",
        "cron",
        "automation",
        "agentic",
        "admin",
        "react",
        "vite",
        "tailwind",
        "dashboard"
    ],
    "authors": [
        {
            "name": "Lorenzo Padovani",
            "email": "lorenzo.padovani@padosoft.com",
            "homepage": "https://github.com/padosoft"
        }
    ],
    "homepage": "https://github.com/padosoft/laravel-routines-admin",
    "support": {
        "issues": "https://github.com/padosoft/laravel-routines-admin/issues",
        "source": "https://github.com/padosoft/laravel-routines-admin"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "padosoft/laravel-routines": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Padosoft\\RoutinesAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\RoutinesAdmin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Padosoft\\RoutinesAdmin\\RoutinesAdminServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
